{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "iisSettings": {
    "windowsAuthentication": true, // Windows Authentication must be enabled
    "anonymousAuthentication": false, // Disable anonymous authentication
    "iisExpress": {
      "applicationUrl": "https://localhost:7261", // URL to launch the backend
      "sslPort": 44314 // Optional: SSL port for IIS Express
    }
  },
  "profiles": {
    "https": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "applicationUrl": "https://localhost:7261", // Backend URL for HTTPS
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    }
  }
}